# Optional: Hugging Face token for remote Affine-S6 inference
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: OpenAI-compatible endpoint (vLLM, SGLang, Featherless, etc.)
# AFFINE_API_BASE=https://api.featherless.ai/v1
# AFFINE_API_KEY=
# AFFINE_MODEL=WebScraper991923/Affine-S6

# Inference backend: auto | local | huggingface | openai
AFFINE_BACKEND=auto

# Humanizer: https://huggingface.co/mradermacher/Ai-Humanizer-Llama-3.2-3B-GGUF
# HUMANIZER_BACKEND=auto   # auto | gguf | heuristic | huggingface | openai
# HUMANIZER_GGUF_FILE=Ai-Humanizer-Llama-3.2-3B.Q4_K_M.gguf
# HUMANIZER_API_BASE=
# HUMANIZER_API_KEY=
