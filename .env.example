# Optional: Hugging Face token for remote Affine-S6 inference
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: OpenAI-compatible endpoint (vLLM, SGLang, Featherless, etc.)
# AFFINE_API_BASE=https://api.featherless.ai/v1
# AFFINE_API_KEY=
# AFFINE_MODEL=WebScraper991923/Affine-S6

# Inference backend: auto | local | huggingface | openai
AFFINE_BACKEND=auto

# Humanizer: https://huggingface.co/mradermacher/Ai-Humanizer-Llama-3.2-3B-GGUF
# HUMANIZER_BACKEND=auto   # auto | gguf | heuristic | huggingface | openai
# HUMANIZER_GGUF_FILE=Ai-Humanizer-Llama-3.2-3B.Q4_K_M.gguf
# HUMANIZER_API_BASE=
# HUMANIZER_API_KEY=

# Cover letters: send applications with an email API key (preferred) or SMTP.
# APPLY_FROM=you@example.com
# APPLY_EMAIL_BACKEND=auto
# APPLY_API_KEY=              # Resend (re_...) or SendGrid (SG....)
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_API_BASE=https://api.mailgun.net
# APPLY_SMTP_HOST=smtp.example.com
# APPLY_SMTP_PORT=587
# APPLY_SMTP_USER=
# APPLY_SMTP_PASSWORD=
# APPLY_SMTP_TLS=1
# APPLY_PHONE=
# APPLY_DIR=.applications

# Optional: company's Greenhouse Job Board API key (not a personal key).
# GREENHOUSE_JOB_BOARD_KEY=
