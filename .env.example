# Mailbox login (preferred over vendor API keys)
APPLY_FROM=you@example.com
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=you@example.com
MAIL_PASSWORD=
# APPLY_SMTP_HOST / APPLY_SMTP_USER / APPLY_SMTP_PASSWORD still work as aliases.

# Paperless-ngx OCR login — https://github.com/paperless-ngx/paperless-ngx
# docker compose up  then:
PAPERLESS_URL=http://localhost:8000
PAPERLESS_USER=admin
PAPERLESS_PASSWORD=changeme
# PAPERLESS_TOKEN=   # optional; otherwise Job-finder logs in at /api/token/

# Safety
APPLY_DAILY_CAP=5
FOLLOWUP_DAYS=10

# Optional: Hugging Face token for remote Affine-S6 inference
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: OpenAI-compatible endpoint (vLLM, SGLang, Featherless, etc.)
# AFFINE_API_BASE=https://api.featherless.ai/v1
# AFFINE_API_KEY=
# AFFINE_MODEL=WebScraper991923/Affine-S6
AFFINE_BACKEND=auto

# Humanizer: https://huggingface.co/mradermacher/Ai-Humanizer-Llama-3.2-3B-GGUF
# HUMANIZER_BACKEND=auto
# HUMANIZER_GGUF_FILE=Ai-Humanizer-Llama-3.2-3B.Q4_K_M.gguf

# Optional vendor email APIs (mailbox login is preferred)
# APPLY_API_KEY=
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=

# Optional: company's Greenhouse Job Board API key (not a personal login).
# GREENHOUSE_JOB_BOARD_KEY=
# GREENHOUSE_BOARDS=stripe,airbnb,discord,figma,notion,cloudflare,databricks
# ASHBY_BOARDS=openai,anthropic,notion,linear
# LEVER_COMPANIES=netflix,spotify,duolingo

# USAJobs: email is your login identity; the auth key is issued after you
# log into https://developer.usajobs.gov/ (not a LinkedIn/Indeed password).
# USAJOBS_EMAIL=you@example.com
# USAJOBS_AUTH_KEY=
